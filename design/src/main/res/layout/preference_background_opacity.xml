<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/item_header_margin"
    android:paddingEnd="@dimen/item_tailing_margin"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/background_opacity"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

    <TextView
        android:id="@+id/background_opacity_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/background_opacity_slider"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:max="100"
        android:contentDescription="@string/background_opacity" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/background_opacity_hint"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />
</LinearLayout>
